# Prefer the README's "Set up with your agent" request for guided installation.
# Manual reference: docs/SETUP.md; FULU slicer/bridge setup: docs/FULU.md.

# Direct LAN printer connection. Replace these values; keep this file private
# after copying it to .env. The LAN access code is not an account password.
PRINTER_HOST=192.168.1.100
BAMBU_SERIAL=your_serial_number
BAMBU_TOKEN=your_lan_access_code
# Required for slicing/printing: set the actual model, e.g. p1s, a1, h2d.
# Leave blank until confirmed. X2D printing requires the optional native helper.
BAMBU_MODEL=
# Native certificate provisioning: 0 for a cloud-paired printer, 1 for a printer
# configured in LAN-only mode (helper default). A VPN connection does not change this.
# BAMBU_NATIVE_LAN_ONLY=0
# NOZZLE_DIAMETER=0.4
# BED_TYPE=textured_plate
# Installed nozzle for Bambu slicing if not the model's stock nozzle
# (stainless_steel, hardened_steel, tungsten_carbide, brass). P1S/P1P/A1 presets assume stainless_steel.
# BAMBU_NOZZLE_TYPE=hardened_steel
# Installed nozzle flow type for Bambu slicing (standard, high_flow; default standard).
# BAMBU_NOZZLE_VOLUME_TYPE=high_flow
# How long to watch fresh printer reports after a print command, in ms (0-60000, default 15000; 0 skips).
# BAMBU_DISPATCH_CHECK_MS=15000
# Human preflight for print starts and positive manual heating (default: 1).
# Only explicitly configured headless setups should set this to 0.
# FINISH bed-clearance and hardware-error clearing still require human elicitation.
BAMBU_REQUIRE_CONFIRMATION=1
# How long a confirmation or model prompt waits for a person, in milliseconds
# (default: 600000, ten minutes; accepted range 1000-3600000, otherwise the default).
# An unanswered prompt sends nothing to the printer.
# BAMBU_CONFIRMATION_TIMEOUT_MS=600000

# Optional slicer; unnecessary when printing an already sliced project.
# BambuStudio/FULU/Orca require matching installed machine presets; see docs/FULU.md.
# Set SLICER_PATH to your installed executable when platform discovery differs.
SLICER_TYPE=bambustudio
# SLICER_PATH=/Applications/BambuStudio.app/Contents/MacOS/BambuStudio
SLICER_PROFILE=
# BAMBU_PROFILES_ROOT=/path/to/matching/installation/resources/profiles

# Optional remote Orca backend: no local slicer executable is required.
# The read-only profile tree must match the remote Orca installation.
# Supports one filament slot and one selected plate; see docs/SLICING.md.
# SLICER_TYPE=orca-slicer-api
# SLICER_API_URL=http://orcaslicer:3000
# BAMBU_PROFILES_ROOT=/mnt/orca/resources/profiles
# SLICER_API_MODE=sync  # sync or async
# SLICER_API_TIMEOUT_MS=600000
# Optional reverse-proxy authentication; never put credentials in the URL.
# SLICER_API_TOKEN=
# SLICER_API_TOKEN_HEADER=Authorization  # Bearer token; custom headers send raw token

# Optional FULU BambuNetwork bridge; selecting a slicer does not enable this.
# Use the host binary/platform wrapper command, not the slicer GUI.
# BAMBU_NETWORK_BRIDGE_COMMAND=
# PJARCZAK_BAMBU_PLUGIN_DIR=/path/to/fulu-runtime
# BAMBU_DEV_ID=your_device_id
# BAMBU_NETWORK_CONFIG_DIR=/private/persistent/bambu-network
# BAMBU_NETWORK_COUNTRY_CODE=US
# BAMBU_NETWORK_USER_INFO=  # Sensitive runtime-compatible JSON, not a password.

# Trusted ffmpeg executable used for RTSP camera snapshots
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# Dedicated X2D profile: persistent job observations, separate from temporary slices.
# Defaults to $XDG_STATE_HOME/bambu-x2d or ~/.local/state/bambu-x2d.
# BAMBU_STATE_DIR=/private/persistent/bambu-x2d
# Saved print roots, separated by : on macOS/Linux or ; on Windows. Defaults to TEMP_DIR.
# BAMBU_LIBRARY_DIRS=/path/to/models:/path/to/slices

# Optional macOS cloud print route. Reuses the named Studio login without opening its GUI.
# Upload-only tools remain local and never use cloud print submission as a fallback.
# BAMBU_NATIVE_PRINT_ROUTE=cloud
# BAMBU_CLOUD_STUDIO_DIR=/Users/you/Library/Application Support/BambuStudioBeta

# Transport: stdio (default) or streamable-http
MCP_TRANSPORT=stdio
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=3000
# MCP_HTTP_PATH=/mcp
# MCP_HTTP_ALLOWED_ORIGINS=http://localhost

# Optional standard Blender MCP integration (start its addon inside Blender).
# BLENDER_MCP_COMMAND=/absolute/path/to/uvx
# BLENDER_MCP_ARGS='["blender-mcp"]'
# BLENDER_MCP_TIMEOUT_MS=120000
# Legacy custom executable bridge:
# BLENDER_MCP_BRIDGE_COMMAND=

# Accept per-call executable selectors such as slicer_path, ffmpeg_path, and
# bridge_command. Off by default; configure trusted executables above instead.
# MCP_ALLOW_BRIDGE_COMMAND_ARG remains a legacy alias for bridge_command only.
MCP_ALLOW_EXECUTABLE_ARG=false

# Leave TEMP_DIR unset for a private OS temporary directory per server instance.
